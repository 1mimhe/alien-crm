{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hoosha-crm-prioritizer",
  "main": "src/index.js",
  "compatibility_date": "2024-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "HOOSHA_API_URL": "https://panel.hooshacrm.ir/api/my/cartable"
  },
  "triggers": {
    "crons": [
      "30 5 * * *" // 09:00 AM Iran Time (UTC 05:30) every day
    ]
  }
}
